# ============================================================
# FORENSIC-X — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environment ───────────────────────────────────────
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# ── Environment Variables (CRITICAL — never commit) ───────────
.env
.env.local
.env.*.local
*.env

# ── Secrets ───────────────────────────────────────────────────
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# ── Evidence & Report Storage (potentially sensitive) ─────────
evidence_store/
reports_store/
uploads/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Database ─────────────────────────────────────────────────
*.db
*.sqlite3
*.sql

# ── IDE & Editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing & Coverage ───────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.coveragerc
.mypy_cache/
.dmypy.json
dmypy.json

# ── Docker ───────────────────────────────────────────────────
.docker/

# ── Node / Frontend build artifacts ──────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
dist/

# ── Alembic ──────────────────────────────────────────────────
# Keep migrations directory tracked, exclude generated files:
# migrations/versions/*.pyc  <- handled by *.pyc above

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Temporary ────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.backup
