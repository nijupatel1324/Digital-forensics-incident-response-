# ============================================================
# FORENSIC-X — .env.example
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="FORENSIC-X"
APP_VERSION="1.0.0"
APP_ENV="development"          # development | staging | production
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
APP_BASE_URL="http://localhost:8000"

# ── Security ─────────────────────────────────────────────────
SECRET_KEY="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"
JWT_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX_STRING"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost:8000,http://localhost:3000"

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://forensicx:CHANGE_ME_STRONG_PASSWORD@localhost:5432/forensicx_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false            # Set true to log SQL queries

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""              # Set if Redis auth is enabled

# ── Admin Bootstrap ──────────────────────────────────────────
ADMIN_EMAIL="admin@forensicx.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
ADMIN_FULL_NAME="System Administrator"

# ── File Storage ─────────────────────────────────────────────
EVIDENCE_UPLOAD_DIR="./evidence_store"
REPORTS_DIR="./reports_store"
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EVIDENCE_EXTENSIONS=".log,.evtx,.pcap,.cap,.csv,.json,.xml,.txt,.zip,.tar,.gz,.pdf,.png,.jpg,.jpeg,.bmp,.tiff"

# ── Email (for password reset, notifications) ─────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@forensicx.local"
SMTP_FROM_NAME="FORENSIC-X Platform"
SMTP_TLS=true

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_API="100/minute"
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ── MFA ──────────────────────────────────────────────────────
MFA_ISSUER_NAME="FORENSIC-X"
MFA_ENABLED=false              # Set true to require MFA

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"              # json | console
LOG_FILE="./logs/forensicx.log"

# ── Detection Engine ──────────────────────────────────────────
DETECTION_BRUTE_FORCE_THRESHOLD=5
DETECTION_BRUTE_FORCE_WINDOW_SECONDS=300
DETECTION_ENABLED=true

# ── External Threat Intel (optional) ─────────────────────────
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
THREAT_INTEL_ENABLED=false
